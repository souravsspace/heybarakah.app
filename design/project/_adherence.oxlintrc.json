{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "(account)/**",
              "(app)/(tabs)/**",
              "(app)/**",
              "(onboarding)/**",
              "(onboarding)/config/**",
              "(onboarding)/paywall/**",
              "(onboarding)/quiz/**",
              "(settings)/**",
              "achievement-card.tsx",
              "achievement-dialog.tsx",
              "achievement-popup-provider.tsx",
              "area-chart.tsx",
              "ayahs.ts",
              "design.ts",
              "external-link.tsx",
              "force-update-gate.tsx",
              "force-update-modal.tsx",
              "glass-surface.tsx",
              "haptic-tab.tsx",
              "index.tsx",
              "links.ts",
              "log-prayer.tsx",
              "meshes.tsx",
              "modal.tsx",
              "no-active-sub.tsx",
              "notification-copy.ts",
              "onboarding-config.ts",
              "onboarding/**",
              "onboarding/illustrations/**",
              "onboarding/paywall/**",
              "parallax-scroll-view.tsx",
              "prayer-matrix.tsx",
              "prayer-source-chip.tsx",
              "scroll-blur-header.tsx",
              "social-apps.ts",
              "splash/**",
              "theme.ts",
              "themed-text.tsx",
              "themed-view.tsx",
              "ui/**",
              "ui_kits/app/**",
              "welcome-card-content.ts"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Libre Baskerville|Inter))/i]",
        "message": "Font not provided by the design system. Available: Libre Baskerville, Inter."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
