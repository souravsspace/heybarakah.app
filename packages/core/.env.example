# Local Convex deployment (used by `bunx convex dev`)
CONVEX_DEPLOYMENT=dev:id
CONVEX_URL=https://your-deployment.convex.cloud
CONVEX_SITE_URL=https://your-deployment.convex.site

# Convex-side secrets — DO NOT set here. Push to Convex dashboard:
#   bunx convex env set RESEND_API_KEY re_xxx
#   bunx convex env set RESEND_AUDIENCE_ID 00000000-0000-0000-0000-000000000000
#   bunx convex env set RESEND_FROM "Barakah <salam@heybarakah.app>"
#   bunx convex env set RESEND_REPLY_TO hello@heybarakah.app
#   bunx convex env set RESEND_AUTH_EMAIL "Barakah <no-reply@heybarakah.app>"
#   bunx convex env set RESEND_WEBHOOK_SECRET whsec_xxx
#   bunx convex env set POLAR_WEBHOOK_SECRET polar_whs_xxx
#   bunx convex env set SITE_URL https://heybarakah.app
#   bunx convex env set NATIVE_APP_URL barakah://
#   bunx convex env set GOOGLE_CLIENT_ID xxx
#   bunx convex env set GOOGLE_CLIENT_SECRET xxx
#   bunx convex env set BETTER_AUTH_SECRET=$(openssl rand -base64 32)
#   bunx convex env set APPLE_CLIENT_ID com.souravsspace.Barakah.signin
#   bunx convex env set APPLE_APP_BUNDLE_IDENTIFIER com.souravsspace.Barakah
#   bunx convex env set APPLE_CLIENT_SECRET <output of scripts/generate-apple-secret.ts>

# Local-only — required ONLY to run scripts/generate-apple-secret.ts.
# Delete after generating the JWT. Never commit the .p8 file.
# APPLE_TEAM_ID=CG5WX63737
# APPLE_KEY_ID=XXXXXXXXXX
# APPLE_CLIENT_ID=com.souravsspace.Barakah.signin
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
