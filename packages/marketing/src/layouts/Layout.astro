---
import { appConfig } from "../app-config";
import AnnounceBar from "../components/AnnounceBar.astro";
import Footer from "../components/Footer.astro";
import { faqItems } from "../lib/faq-data";
import "../styles/global.css";

interface Props {
  description?: string;
  title?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  type?: "website" | "article";
  canonical?: string;
  includeFaqJsonLd?: boolean;
  htmlClass?: string;
  bodyClass?: string;
}

const {
  title = "Barakah — Your phone, on prayer time.",
  description = "Barakah locks distractions during salah so you show up, not scroll. A quiet prayer-lock app for Muslims.",
  image,
  imageAlt = appConfig.seo.ogImageAlt,
  noindex = false,
  type = "website",
  canonical,
  includeFaqJsonLd = false,
  htmlClass = "",
  bodyClass = "",
} = Astro.props;

const siteUrl = appConfig.seo.siteUrl;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(image ?? appConfig.seo.ogImage, siteUrl).toString();
const robotsContent = noindex
  ? "noindex,nofollow"
  : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";

const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: appConfig.brand.name,
  legalName: appConfig.brand.legalName,
  url: siteUrl,
  logo: new URL("/barakah-app-icon.png", siteUrl).toString(),
  email: appConfig.contact.email,
  description: appConfig.brand.description,
  sameAs: [appConfig.social.twitter],
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer support",
    email: appConfig.contact.email,
    availableLanguage: ["English"],
  },
};

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: appConfig.brand.name,
  url: siteUrl,
  inLanguage: appConfig.seo.language,
};

const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: appConfig.brand.name,
  description: appConfig.brand.description,
  applicationCategory: "LifestyleApplication",
  operatingSystem: "iOS, Android",
  url: siteUrl,
  image: ogImageUrl,
  inLanguage: appConfig.seo.language,
  featureList: [
    "Prayer lock at all five salah windows (Fajr, Dhuhr, Asr, Maghrib, Isha)",
    "Choose which apps go quiet during prayer",
    "Calls, Qur'an, maps and emergency tools stay open",
    "Adhan, qibla and prayer times included",
    "Shafi'i and Hanafi Asr calculation with per-prayer overrides",
    "Works offline; prayer settings stay on-device",
  ],
  audience: {
    "@type": "PeopleAudience",
    audienceType: "Muslims observing the five daily prayers",
  },
  keywords: appConfig.seo.keywords.join(", "),
  offers: {
    "@type": "Offer",
    price: "39.99",
    priceCurrency: "USD",
    category: "LifetimeAccess",
    availability: "https://schema.org/PreOrder",
    url: appConfig.pricing.checkoutUrl,
  },
  publisher: {
    "@type": "Organization",
    name: appConfig.brand.name,
    url: siteUrl,
  },
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---

<!doctype html>
<html lang={appConfig.seo.language} class={htmlClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={appConfig.seo.keywords.join(", ")} />
    <meta name="author" content={appConfig.brand.legalName} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="theme-color" content={appConfig.seo.themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="application-name" content={appConfig.brand.shortName} />
    <meta name="apple-mobile-web-app-title" content={appConfig.brand.shortName} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <link
      rel="preload"
      href="/fonts/Inter-VariableFont_opsz_wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/LibreBaskerville-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/barakah-app-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/barakah-app-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms.txt"
      title="Barakah — LLM-friendly summary"
    />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms-full.txt"
      title="Barakah — full LLM brief"
    />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={appConfig.brand.shortName} />
    <meta property="og:locale" content={appConfig.seo.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    {appConfig.seo.twitterHandle && <meta name="twitter:site" content={appConfig.seo.twitterHandle} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationLd).replace(/<\/script/gi, "<\\/script")}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteLd).replace(/<\/script/gi, "<\\/script")}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(softwareLd).replace(/<\/script/gi, "<\\/script")}
    />
    {
      includeFaqJsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(faqLd).replace(/<\/script/gi, "<\\/script")}
        />
      )
    }
  </head>
  <body class:list={["text-[color:var(--color-fg)]", bodyClass]}>
    <AnnounceBar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
