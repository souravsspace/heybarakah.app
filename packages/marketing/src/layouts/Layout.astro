---
import { appConfig } from "../app-config";
import AnnounceBar from "../components/AnnounceBar.astro";
import Footer from "../components/Footer.astro";
import { faqItems } from "../lib/faq-data";
import "../styles/global.css";

interface Props {
  description?: string;
  title?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  type?: "website" | "article";
  canonical?: string;
  includeFaqJsonLd?: boolean;
}

const {
  title = "Barakah — Your phone, on prayer time.",
  description = "Barakah locks distractions during salah so you show up, not scroll. A quiet prayer-lock app for Muslims.",
  image,
  imageAlt = appConfig.seo.ogImageAlt,
  noindex = false,
  type = "website",
  canonical,
  includeFaqJsonLd = false,
} = Astro.props;

const siteUrl = appConfig.seo.siteUrl;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(image ?? appConfig.seo.ogImage, siteUrl).toString();
const robotsContent = noindex ? "noindex,nofollow" : "index,follow";

const organizationLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: appConfig.brand.name,
  legalName: appConfig.brand.legalName,
  url: siteUrl,
  logo: new URL("/barakah-app-icon.png", siteUrl).toString(),
  email: appConfig.contact.email,
  description: appConfig.brand.description,
};

const websiteLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: appConfig.brand.name,
  url: siteUrl,
  inLanguage: appConfig.seo.language,
};

const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: appConfig.brand.name,
  description: appConfig.brand.description,
  applicationCategory: "LifestyleApplication",
  operatingSystem: "iOS, Android",
  url: siteUrl,
  image: ogImageUrl,
  inLanguage: appConfig.seo.language,
  audience: {
    "@type": "PeopleAudience",
    audienceType: "Muslims observing the five daily prayers",
  },
  keywords: appConfig.seo.keywords.join(", "),
  offers: {
    "@type": "Offer",
    price: "39.99",
    priceCurrency: "USD",
    category: "LifetimeAccess",
    availability: "https://schema.org/PreOrder",
    url: appConfig.pricing.checkoutUrl,
  },
  publisher: {
    "@type": "Organization",
    name: appConfig.brand.name,
    url: siteUrl,
  },
};

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};
---

<!doctype html>
<html lang={appConfig.seo.language}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={appConfig.seo.keywords.join(", ")} />
    <meta name="author" content={appConfig.brand.legalName} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="theme-color" content={appConfig.seo.themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="application-name" content={appConfig.brand.shortName} />
    <meta name="apple-mobile-web-app-title" content={appConfig.brand.shortName} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" href="/barakah-app-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/barakah-app-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms.txt"
      title="Barakah — LLM-friendly summary"
    />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms-full.txt"
      title="Barakah — full LLM brief"
    />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={appConfig.brand.shortName} />
    <meta property="og:locale" content={appConfig.seo.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    {appConfig.seo.twitterHandle && <meta name="twitter:site" content={appConfig.seo.twitterHandle} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Libre+Baskerville:ital,wght@0,400;1,400&family=Inter:wght@400;500;600;700&display=swap"
    />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationLd).replace(/<\/script/gi, "<\\/script")}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(websiteLd).replace(/<\/script/gi, "<\\/script")}
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(softwareLd).replace(/<\/script/gi, "<\\/script")}
    />
    {
      includeFaqJsonLd && (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(faqLd).replace(/<\/script/gi, "<\\/script")}
        />
      )
    }
  </head>
  <body class="bg-white text-[color:var(--color-fg)]">
    <AnnounceBar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
