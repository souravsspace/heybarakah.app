---
import { appConfig } from "../app-config";
import AnnounceBar from "../components/AnnounceBar.astro";
import Footer from "../components/Footer.astro";
import { faqItems } from "../lib/faq-data";
import "../styles/global.css";

interface Props {
  description?: string;
  title?: string;
  image?: string;
  imageAlt?: string;
  noindex?: boolean;
  type?: "website" | "article";
  canonical?: string;
  includeFaqJsonLd?: boolean;
  htmlClass?: string;
  bodyClass?: string;
}

const {
  title = "Barakah — Your phone, on prayer time.",
  description = "Barakah locks distractions during salah so you show up, not scroll. A quiet prayer-lock app for Muslims.",
  image,
  imageAlt = appConfig.seo.ogImageAlt,
  noindex = false,
  type = "website",
  canonical,
  includeFaqJsonLd = false,
  htmlClass = "",
  bodyClass = "",
} = Astro.props;

const siteUrl = appConfig.seo.siteUrl;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, siteUrl).toString();
const ogImageUrl = new URL(image ?? appConfig.seo.ogImage, siteUrl).toString();
const robotsContent = noindex
  ? "noindex,nofollow"
  : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1";

// Single connected @graph: entities cross-reference by @id so search engines
// resolve one knowledge entity (Organization → WebSite → WebPage → App) instead
// of disconnected nodes. dateModified is the build time for a freshness signal.
const orgId = `${siteUrl}/#organization`;
const websiteId = `${siteUrl}/#website`;
const softwareId = `${siteUrl}/#software`;
const logoId = `${siteUrl}/#logo`;
const webPageId = `${canonicalUrl}#webpage`;
const primaryImageId = `${ogImageUrl}#primaryimage`;
const faqId = `${canonicalUrl}#faq`;

const logoUrl = new URL("/barakah-app-icon.png", siteUrl).toString();
const datePublished = "2026-05-01";
const dateModified = new Date().toISOString();

const organizationNode = {
  "@type": "Organization",
  "@id": orgId,
  name: appConfig.brand.name,
  legalName: appConfig.brand.legalName,
  url: siteUrl,
  email: appConfig.contact.email,
  description: appConfig.brand.description,
  sameAs: [appConfig.social.twitter],
  logo: {
    "@type": "ImageObject",
    "@id": logoId,
    url: logoUrl,
    contentUrl: logoUrl,
    width: 1024,
    height: 1024,
    caption: appConfig.brand.name,
  },
  image: { "@id": logoId },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer support",
    email: appConfig.contact.email,
    availableLanguage: ["English"],
  },
};

const websiteNode = {
  "@type": "WebSite",
  "@id": websiteId,
  name: appConfig.brand.name,
  alternateName: [appConfig.brand.shortName, "heybarakah"],
  description: appConfig.brand.description,
  url: siteUrl,
  inLanguage: appConfig.seo.language,
  publisher: { "@id": orgId },
};

const primaryImageNode = {
  "@type": "ImageObject",
  "@id": primaryImageId,
  url: ogImageUrl,
  contentUrl: ogImageUrl,
  width: 1200,
  height: 630,
  caption: imageAlt,
};

const webPageNode = {
  "@type": type === "article" ? "Article" : "WebPage",
  "@id": webPageId,
  url: canonicalUrl,
  name: title,
  description,
  inLanguage: appConfig.seo.language,
  isPartOf: { "@id": websiteId },
  about: { "@id": softwareId },
  primaryImageOfPage: { "@id": primaryImageId },
  image: { "@id": primaryImageId },
  datePublished,
  dateModified,
  ...(type === "article"
    ? { author: { "@id": orgId }, publisher: { "@id": orgId } }
    : {}),
};

const softwareNode = {
  "@type": "SoftwareApplication",
  "@id": softwareId,
  name: appConfig.brand.name,
  description: appConfig.brand.description,
  applicationCategory: "LifestyleApplication",
  operatingSystem: "iOS, Android",
  url: siteUrl,
  image: { "@id": primaryImageId },
  inLanguage: appConfig.seo.language,
  featureList: [
    "Prayer lock at all five salah windows (Fajr, Dhuhr, Asr, Maghrib, Isha)",
    "Choose which apps go quiet during prayer",
    "Calls, Qur'an, maps and emergency tools stay open",
    "Adhan, qibla and prayer times included",
    "Shafi'i and Hanafi Asr calculation with per-prayer overrides",
    "Works offline; prayer settings stay on-device",
  ],
  audience: {
    "@type": "PeopleAudience",
    audienceType: "Muslims observing the five daily prayers",
  },
  keywords: appConfig.seo.keywords.join(", "),
  offers: {
    "@type": "Offer",
    price: "99",
    priceCurrency: "USD",
    category: "LifetimeAccess",
    availability: "https://schema.org/InStock",
    url: appConfig.pricing.checkoutUrl,
  },
  publisher: { "@id": orgId },
};

const faqNode = {
  "@type": "FAQPage",
  "@id": faqId,
  isPartOf: { "@id": webPageId },
  mainEntity: faqItems.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.a,
    },
  })),
};

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    organizationNode,
    websiteNode,
    primaryImageNode,
    webPageNode,
    softwareNode,
    ...(includeFaqJsonLd ? [faqNode] : []),
  ],
};
---

<!doctype html>
<html lang={appConfig.seo.language} class={htmlClass}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    {/* Founding lifetime offer surfaces on a fraction of visits only. Runs
        pre-paint so gated blocks never flash in or out. App Store download
        stays the always-on primary CTA regardless. */}
    <script is:inline>
      if (Math.random() < 0.4) document.documentElement.classList.add("ll-on");
    </script>

    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={appConfig.seo.keywords.join(", ")} />
    <meta name="author" content={appConfig.brand.legalName} />
    <meta name="robots" content={robotsContent} />
    <meta name="googlebot" content={robotsContent} />
    <meta name="theme-color" content={appConfig.seo.themeColor} />
    <meta name="color-scheme" content="light" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="application-name" content={appConfig.brand.shortName} />
    <meta name="apple-mobile-web-app-title" content={appConfig.brand.shortName} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />

    <link
      rel="preload"
      href="/fonts/Inter-VariableFont_opsz_wght.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/LibreBaskerville-Bold.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={appConfig.seo.language} href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <link rel="dns-prefetch" href="https://buy.polar.sh" />
    <link rel="preconnect" href="https://buy.polar.sh" crossorigin />
    <link rel="icon" type="image/png" href="/barakah-app-icon.png" />
    <link rel="icon" type="image/svg+xml" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/barakah-app-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms.txt"
      title="Barakah — LLM-friendly summary"
    />
    <link
      rel="alternate"
      type="text/plain"
      href="/llms-full.txt"
      title="Barakah — full LLM brief"
    />
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={appConfig.brand.shortName} />
    <meta property="og:locale" content={appConfig.seo.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    {appConfig.seo.twitterHandle && <meta name="twitter:site" content={appConfig.seo.twitterHandle} />}
    {appConfig.seo.twitterHandle && <meta name="twitter:creator" content={appConfig.seo.twitterHandle} />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />

    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData).replace(/<\/script/gi, "<\\/script")}
    />

    <script
      is:inline
      defer
      src="https://api.trysonex.com/sonex.js"
      data-website-id="7d8407c1-a7e8-472b-9100-5642451a180f"
    />
  </head>
  <body class:list={["text-[color:var(--color-fg)]", bodyClass]}>
    <AnnounceBar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
