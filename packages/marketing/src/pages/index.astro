---
import AskScholar from "../components/AskScholar.astro";
import Checklist from "../components/Checklist.astro";
import Faq from "../components/Faq";
import FinalCta from "../components/FinalCta.astro";
import Hero from "../components/Hero.astro";
import PricingCompare from "../components/PricingCompare.astro";
import Testimonial from "../components/Testimonial.astro";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="Barakah — Your phone, on prayer time."
  description="A quiet prayer-lock app for Muslims. Barakah closes the apps you choose during Fajr, Dhuhr, Asr, Maghrib, and Isha so you show up — not scroll."
  includeFaqJsonLd
>
  <Hero />
  <Checklist />
  <Testimonial />
  <AskScholar />
  <PricingCompare />
  <Faq client:visible />
  <FinalCta />
</Layout>
