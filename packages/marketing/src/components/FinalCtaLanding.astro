---
import { appConfig } from "../app-config";
import NewsletterForm from "./NewsletterForm";

const { pricing } = appConfig;
const { checkout } = Astro.locals;
---

<section class="final geo geo-light" id="newsletter" data-od-id="newsletter">
  <div class="final-halo" aria-hidden="true"></div>
  <div class="wrap">
    <span class="ornament on-green reveal" aria-hidden="true"
      ><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"
        ><rect x="5" y="5" width="14" height="14"></rect><rect
          x="5"
          y="5"
          width="14"
          height="14"
          transform="rotate(45 12 12)"></rect></svg
      ></span
    >
    <p class="final-bism reveal">Bismillah ir-Rahman ir-Raheem.</p>
    <h2 class="reveal d1">Show up; <span class="it">not scroll.</span></h2>
    <p class="reveal d2">
      Get the occasional note from Barakah: new reciters, focus modes for Ramadan and Jumu'ah, and
      gentle reminders to protect your salah. No noise.
    </p>
    <div class="reveal d3">
      <NewsletterForm client:visible />
    </div>
    <div class="launch-notes reveal d3" aria-label="What to expect">
      <span>New reciters and features</span>
      <span>Roughly one email a month</span>
      <span>Prayer settings stay private</span>
    </div>
    <p class="final-or reveal d3 lifetime-only">
      Ready for more? <a href={checkout.url}
        >Reserve founding lifetime access for {pricing.lifetimePrice}</a
      >
    </p>
    {checkout.showCode ? (
      <p class="final-code reveal d3 lifetime-only">
        Use code <b>{checkout.code}</b> for {checkout.percent}% off at checkout.
      </p>
    ) : (
      <p class="final-code reveal d3 lifetime-only">{checkout.percent}% off applied automatically.</p>
    )}
    <p class="final-fine reveal d3">No spam. Unsubscribe anytime. Your address stays with us.</p>
  </div>
</section>
