---
const scholars = [
  {
    name: "Shaykh Abdullah Hassan",
    role: "Maliki fiqh, ijazah from Al-Azhar",
    bio: "Twenty years teaching salah and tahara in masjid programmes across the UK.",
  },
  {
    name: "Ustadha Maryam Siddiqui",
    role: "Hanafi fiqh, female-led halaqas",
    bio: "Reviews questions on women's worship, family, and travel for Barakah.",
  },
  {
    name: "Shaykh Yasin al-Mahdi",
    role: "Shafi'i fiqh, hadith specialist",
    bio: "Verifies citations and ensures every answer carries an authentic chain.",
  },
];
---
<section class="bg-[color:var(--color-surface-soft)] border-y border-[color:var(--color-border)]">
  <div class="mx-auto max-w-5xl px-6 py-28 md:py-32">
    <div class="text-center">
      <p class="t-eyebrow text-[color:var(--color-primary)]">Our scholars</p>
      <h2 class="serif mt-4 text-[36px] leading-[1.1] font-bold text-[color:var(--color-fg)] md:text-[44px]">
        Real teachers stand behind every answer.
      </h2>
    </div>

    <div class="mt-14 grid gap-px overflow-hidden rounded-[4px] border border-[color:var(--color-border)] bg-[color:var(--color-border)] md:grid-cols-3">
      {scholars.map((s) => (
        <article class="bg-white p-7">
          <div class="flex h-14 w-14 items-center justify-center rounded-full bg-[color:var(--color-primary-soft)] text-[color:var(--color-primary)]">
            <span class="serif text-[20px] font-bold">{s.name.split(" ").slice(-1)[0][0]}</span>
          </div>
          <h3 class="serif mt-5 text-[18px] font-bold text-[color:var(--color-fg)]">{s.name}</h3>
          <p class="mt-1 text-[13px] text-[color:var(--color-primary)]">{s.role}</p>
          <p class="mt-3 text-[14px] leading-[22px] text-[color:var(--color-fg-muted)]">{s.bio}</p>
        </article>
      ))}
    </div>
  </div>
</section>
