---
import { appConfig } from "../app-config";

const { pricing, routes } = appConfig;
---

<div class="announce">
  Bismillah — founding lifetime access <span class="strike">{pricing.originalPrice}</span>
  {pricing.lifetimePrice} · <a href={routes.pricing}>see exactly what you reserve</a>
</div>

<style>
  .announce {
    background: #1b3f29;
    color: #fff;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
    padding: 9px 16px;
  }
  .announce a {
    text-decoration: underline;
    text-underline-offset: 3px;
    opacity: 0.92;
    color: inherit;
  }
  .announce .strike {
    opacity: 0.6;
    text-decoration: line-through;
    font-weight: 500;
  }
  @media (max-width: 560px) {
    .announce {
      font-size: 11px;
      padding-inline: 12px;
    }
  }
</style>
