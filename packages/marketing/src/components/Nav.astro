---
import { appConfig } from "../app-config";

const { brand, routes, store } = appConfig;
---

<header class="nav" id="nav">
  <div class="wrap nav-inner">
    <a class="brand" href="#top" aria-label={`${brand.shortName} home`}>
      <span class="brand-mark">
        <img src="/barakah-app-icon.png" alt="" loading="eager" decoding="async" />
      </span>
      <span class="brand-name">{brand.shortName} App</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a class="lnk" href="#prayer-day">Prayer day</a>
      <a class="lnk" href="#amanah">Amanah</a>
      <a class="lnk" href="#features">What it locks</a>
      <a class="lnk lifetime-only" href={routes.pricing}>Pricing</a>
    </nav>
    <div class="nav-cta-group">
      <a class="btn btn-primary btn-sm" href={store.ios.url}>Download</a>
    </div>
  </div>
</header>
