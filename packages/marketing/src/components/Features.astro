---
const features = [
  {
    icon: "lock",
    title: "Prayer lock",
    body: "When salah enters, distracting apps quietly close. Allowlist what truly belongs — Qur'an, du'a, calls.",
  },
  {
    icon: "bell",
    title: "Adhan, gently",
    body: "Hand-recited adhan from reciters you choose. Soft fade-in, never jarring. Snooze isn't an option.",
  },
  {
    icon: "compass",
    title: "Qibla & times",
    body: "Accurate prayer times for your city, plus a calm qibla compass. No ads, no analytics, no noise.",
  },
];
---
<section id="features" class="relative">
  <div class="mx-auto max-w-6xl px-6 py-28 md:py-32">
    <div class="mx-auto max-w-2xl text-center">
      <p class="t-eyebrow text-[color:var(--color-primary)]">Three things, done well</p>
      <h2 class="serif mt-4 text-[36px] leading-[1.1] font-bold text-[color:var(--color-fg)] md:text-[44px]">
        A quiet companion for every salah.
      </h2>
      <p class="mt-5 text-[17px] leading-[26px] text-[color:var(--color-fg-muted)]">
        Barakaah does very little — and that is the point. No streaks, no leaderboards, no gamified worship.
      </p>
    </div>

    <div class="mt-16 grid gap-px overflow-hidden rounded-[4px] border border-[color:var(--color-border)] bg-[color:var(--color-border)] md:grid-cols-3">
      {features.map((f) => (
        <article class="bg-white p-8 md:p-10">
          <span class="inline-flex h-12 w-12 items-center justify-center rounded-full bg-[color:var(--color-primary-soft)] text-[color:var(--color-primary)]">
            {f.icon === "lock" && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            )}
            {f.icon === "bell" && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg>
            )}
            {f.icon === "compass" && (
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m16.24 7.76-2.12 6.36-6.36 2.12 2.12-6.36 6.36-2.12z"/></svg>
            )}
          </span>
          <h3 class="serif mt-7 text-[24px] font-bold text-[color:var(--color-fg)]">{f.title}</h3>
          <p class="mt-3 text-[15px] leading-[24px] text-[color:var(--color-fg-muted)]">{f.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
