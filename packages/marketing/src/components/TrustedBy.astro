---
const partners = [
  "Al-Madinah Institute",
  "Cambridge Muslim College",
  "AlMaghrib",
  "Bayyinah",
  "Zaytuna College",
  "Yaqeen Institute",
];
---
<section class="border-b border-[color:var(--color-border)] bg-white">
  <div class="mx-auto max-w-3xl px-6 py-20 md:py-24">
    <p class="text-center text-xs uppercase tracking-[0.18em] text-[color:var(--color-fg-subtle)]">
      Reviewed in collaboration with
    </p>
    <div class="mt-10 grid grid-cols-2 gap-y-6 gap-x-10 md:grid-cols-3 md:gap-y-8 lg:grid-cols-6">
      {partners.map((p) => (
        <div class="flex items-center justify-center text-center">
          <span class="serif text-base font-bold text-[color:var(--color-fg-muted)] md:text-base">{p}</span>
        </div>
      ))}
    </div>
  </div>
</section>
