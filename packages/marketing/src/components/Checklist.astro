---
const items = [
  "You miss salah because your phone pulls you elsewhere.",
  "You open apps mid-wudu without realising.",
  "You silence the adhan and forget to come back.",
  "You finish a doomscroll and the prayer window has closed.",
  "You want your phone to honour your salah, not interrupt it.",
];
---
<section class="bg-[color:var(--color-surface-soft)] border-y border-[color:var(--color-border)]">
  <div class="mx-auto max-w-3xl px-6 py-24 md:py-28">
    <div class="text-center">
      <p class="t-eyebrow text-[color:var(--color-primary)]">Do you need Barakah?</p>
      <h2 class="serif mt-4 text-[32px] leading-[1.15] font-bold text-[color:var(--color-fg)] md:text-[38px]">
        If any of these sound familiar.
      </h2>
    </div>

    <ul class="mt-14 space-y-px overflow-hidden rounded-[4px] border border-[color:var(--color-border)] bg-white">
      {items.map((item, i) => (
        <li class={`flex items-start gap-4 px-6 py-5 ${i !== 0 ? "border-t border-[color:var(--color-border)]" : ""}`}>
          <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-[color:var(--color-primary)] bg-[color:var(--color-primary-soft)] text-[color:var(--color-primary)]">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
          </span>
          <p class="text-[16px] leading-[24px] text-[color:var(--color-fg)]">{item}</p>
        </li>
      ))}
    </ul>

    <p class="mt-10 text-center text-[14px] text-[color:var(--color-fg-muted)]">
      Then Barakah was made for you.
    </p>
  </div>
</section>
