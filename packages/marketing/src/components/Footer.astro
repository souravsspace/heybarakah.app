---
const groups = [
  {
    title: "Product",
    links: [
      { label: "Features", href: "#features" },
      { label: "FAQ", href: "#faq" },
      { label: "Waitlist", href: "#waitlist" },
    ],
  },
  {
    title: "Company",
    links: [
      { label: "About", href: "#" },
      { label: "Contact", href: "#" },
    ],
  },
  {
    title: "Legal",
    links: [
      { label: "Privacy", href: "#" },
      { label: "Terms", href: "#" },
    ],
  },
];
---
<footer class="border-t border-[color:var(--color-border)] bg-white">
  <div class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-12 md:grid-cols-[1.4fr_1fr_1fr_1fr]">
      <div>
        <a href="/" class="flex items-center gap-3" aria-label="Barakaah">
          <img src="/barakaah-app-icon.png" alt="" class="h-9 w-9 rounded-[8px]" />
          <span class="serif text-[20px] font-bold tracking-tight text-[color:var(--color-fg)]">Barakaah</span>
        </a>
        <p class="mt-5 max-w-[280px] text-[14px] leading-[22px] text-[color:var(--color-fg-muted)]">
          A quiet companion for salah. Made with reverence, in service of every muslim.
        </p>
      </div>
      {groups.map((g) => (
        <div>
          <p class="t-eyebrow text-[color:var(--color-fg-subtle)]">{g.title}</p>
          <ul class="mt-5 space-y-3">
            {g.links.map((l) => (
              <li>
                <a href={l.href} class="text-[14px] text-[color:var(--color-fg)] transition-opacity hover:opacity-70">
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-14 flex flex-col items-start justify-between gap-3 border-t border-[color:var(--color-border)] pt-8 text-[13px] text-[color:var(--color-fg-subtle)] md:flex-row md:items-center">
      <p>© {new Date().getFullYear()} Barakaah. All rights reserved.</p>
      <p>Bismillah ir-Rahman ir-Raheem.</p>
    </div>
  </div>
</footer>
