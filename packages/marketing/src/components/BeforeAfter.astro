---
const before = [
  "Adhan plays. You silence it.",
  "You promise to pray after one more reel.",
  "The window closes. Guilt, again.",
  "Phone stays loud. Salah stays late.",
];

const after = [
  "Adhan fades in. Apps step aside.",
  "Two minutes of stillness, by default.",
  "You pray on time, then return.",
  "Phone honours salah. So do you.",
];
---
<section class="bg-[color:var(--color-surface-soft)] border-y border-[color:var(--color-border)]">
  <div class="mx-auto max-w-5xl px-6 py-28 md:py-32">
    <div class="mx-auto max-w-2xl text-center">
      <p class="t-eyebrow text-[color:var(--color-primary)]">Before & after</p>
      <h2 class="serif mt-4 text-[36px] leading-[1.1] font-bold text-[color:var(--color-fg)] md:text-[44px]">
        A small change, felt five times a day.
      </h2>
    </div>

    <div class="mt-16 grid overflow-hidden rounded-[4px] border border-[color:var(--color-border)] bg-white md:grid-cols-2">
      <div class="border-b border-[color:var(--color-border)] p-8 md:border-r md:border-b-0 md:p-10">
        <p class="t-eyebrow text-[color:var(--color-fg-subtle)]">Without Barakah</p>
        <ul class="mt-6 space-y-4">
          {before.map((b) => (
            <li class="flex items-start gap-3 text-[15px] leading-[24px] text-[color:var(--color-fg-muted)]">
              <span class="mt-1 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full border border-[color:var(--color-border-strong)] text-[color:var(--color-fg-subtle)]">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
              </span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="bg-[color:var(--color-primary-soft)]/30 p-8 md:p-10">
        <p class="t-eyebrow text-[color:var(--color-primary)]">With Barakah</p>
        <ul class="mt-6 space-y-4">
          {after.map((a) => (
            <li class="flex items-start gap-3 text-[15px] leading-[24px] text-[color:var(--color-fg)]">
              <span class="mt-1 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-[color:var(--color-primary)] text-white">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
              </span>
              <span>{a}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
