{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "heybarakah-marketing",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2026-05-12",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "PUBLIC_CONVEX_URL": "https://descriptive-vulture-195.convex.cloud"
  }
}
