{
  "extends": ["expo/tsconfig.base", "@barakah/tsconfig/app.json"],
  "compilerOptions": {
    "types": ["node", "bun"],
    "paths": {
      "@/*": ["./*"],
      "@barakah/core/*": ["../core/*"],
      "@barakah/env/*": ["../env/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
