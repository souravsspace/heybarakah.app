{
  "expo": {
    "name": "Barakah",
    "slug": "Barakah",
    "version": "0.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "barakah",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.souravsspace.Barakah",
      "appleTeamId": "CG5WX63737",
      "usesAppleSignIn": true,
      "infoPlist": {
        "UIViewControllerBasedStatusBarAppearance": false,
        "ITSAppUsesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.family-controls": true,
        "com.apple.security.application-groups": [
          "group.com.souravsspace.Barakah.shield",
          "group.com.souravsspace.Barakah.expowidgets"
        ]
      },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF4E8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.souravsspace.Barakah"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#FAF4E8",
          "dark": {
            "backgroundColor": "#0F1311"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Barakah to access your photos to set a profile picture."
        }
      ],
      [
        "expo-app-blocker",
        {
          "ios": {
            "appGroup": "group.com.souravsspace.Barakah.shield",
            "shield": {
              "title": "Quiet at salah.",
              "subtitle": "{appName} rests for prayer.",
              "primaryButtonLabel": "Open Barakah",
              "secondaryButtonLabel": null,
              "primaryButtonColor": "#29603E",
              "titleColor": "#0A0A0A",
              "darkTitleColor": "#F2F4F1",
              "subtitleColor": "#6B7280",
              "darkSubtitleColor": "#9CA39B",
              "backgroundColor": "#FFFFFF",
              "darkBackgroundColor": "#0E0F0E",
              "backgroundBlurStyle": "systemThickMaterial",
              "countSuffix": " {count} apps are quiet.",
              "tempUnlockTitle": "Almost there.",
              "tempUnlockSubtitle": "Quiet lifts in a moment.",
              "tempUnlockButtonLabel": "OK"
            },
            "notification": {
              "title": "Barakah",
              "body": "Return to complete your prayer.",
              "attachIcon": false
            }
          }
        }
      ],
      "expo-background-task",
      [
        "expo-native-fonts",
        {
          "Inter": [
            {
              "path": "./assets/fonts/Inter.ttf",
              "weight": 400
            }
          ],
          "LibreBaskerville-Bold": [
            {
              "path": "./assets/fonts/LibreBaskerville-Bold.ttf",
              "weight": 700
            }
          ]
        }
      ],
      [
        "@bittingz/expo-widgets",
        {
          "ios": {
            "src": "../../modules/expo-barakah-widgets/ios",
            "devTeamId": "CG5WX63737",
            "deploymentTarget": "17.0",
            "useLiveActivities": true,
            "frequentUpdates": true,
            "moduleDependencies": [
              "Shared/WidgetSnapshot.swift",
              "Shared/SharedStore.swift",
              "Shared/LockActivityAttributes.swift",
              "Shared/LockActivityController.swift"
            ],
            "mode": "production",
            "xcode": {
              "widgetBundleIdentifier": "com.souravsspace.Barakah.BarakahWidgets"
            }
          }
        }
      ],
      "./plugins/with-app-groups",
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.souravsspace.Barakah.DeviceActivityMonitor",
                  "targetName": "DeviceActivityMonitor",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.souravsspace.Barakah.shield"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.souravsspace.Barakah.ShieldAction",
                  "targetName": "ShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.souravsspace.Barakah.shield"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.souravsspace.Barakah.ShieldConfiguration",
                  "targetName": "ShieldConfiguration",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.souravsspace.Barakah.shield"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "0cc15480-24aa-452a-a6e6-b4e125043f31"
      },
      "router": {}
    },
    "owner": "souravsspace"
  }
}
