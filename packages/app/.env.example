# PostHog analytics + error tracking. Leave blank to disable (analytics no-ops).
EXPO_PUBLIC_POSTHOG_KEY=
# PostHog host. Default https://us.i.posthog.com (EU: https://eu.i.posthog.com)
EXPO_PUBLIC_POSTHOG_HOST=
