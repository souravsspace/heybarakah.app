{
  "name": "heybarakah.app",
  "type": "module",
  "version": "0.9.5",
  "packageManager": "bun@1.3.10",
  "private": true,
  "scripts": {
    "dev:app": "bun --cwd packages/app start",
    "dev:marketing": "bun --cwd packages/marketing dev",
    "dev:api": "bun --cwd packages/api dev",
    "build:api": "bun --cwd packages/api build",
    "test:api": "bun --cwd packages/api test",
    "deploy:api": "bun --cwd packages/api deploy",
    "db:generate:api": "bun --cwd packages/api db:generate",
    "db:migrate:api": "bun --cwd packages/api db:migrate",
    "db:migrate:api:dev": "bun --cwd packages/api db:migrate:dev",
    "db:migrate:api:prod": "bun --cwd packages/api db:migrate:prod",
    "reset:db:api": "bun --cwd packages/api reset:db",
    "typecheck": "bunx turbo run typecheck",
    "check": "bun x ultracite check",
    "fix": "bun x ultracite fix"
  },
  "workspaces": {
    "packages": [
      "packages/*",
      "modules/*"
    ],
    "catalog": {
      "typescript": "~6.0.3",
      "@types/bun": "1.3.13",
      "zod": "^4.4.3",
      "better-auth": "~1.6.9",
      "@better-auth/expo": "~1.6.9",
      "react": "19.2.3",
      "react-dom": "19.2.3"
    }
  },
  "devDependencies": {
    "@barakah/tsconfig": "workspace:*",
    "@biomejs/biome": "2.4.14",
    "@types/bun": "catalog:",
    "lint-staged": "^16.4.0",
    "turbo": "^2.8.20",
    "ultracite": "7.6.3"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix"
    ]
  },
  "dependencies": {}
}
