{
  "name": "heybarakah.app",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "bun@1.3.10",
  "private": true,
  "scripts": {
    "dev:app": "bun --cwd packages/app start",
    "dev:api": "bun --cwd packages/api dev",
    "dev:convex": "bun --cwd packages/convex dev",
    "dev:marketing": "bun --cwd packages/marketing dev",
    "typecheck": "bunx turbo run typecheck"
  },
  "workspaces": {
    "packages": [
      "packages/*"
    ],
    "catalog": {
      "typescript": "~5.9.2",
      "@types/bun": "1.3.13",
      "zod": "^4.4.3",
      "dotenv": "^17.4.2",
      "convex": "^1.38.0",
      "better-auth": "~1.6.9",
      "@better-auth/expo": "~1.6.9",
      "@convex-dev/better-auth": "^0.12.2"
    }
  },
  "devDependencies": {
    "@barakah/tsconfig": "workspace:*",
    "@biomejs/biome": "2.4.14",
    "@types/bun": "catalog:",
    "lint-staged": "^16.4.0",
    "turbo": "^2.8.20",
    "ultracite": "7.6.3"
  },
  "peerDependencies": {
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix"
    ]
  },
  "dependencies": {}
}
