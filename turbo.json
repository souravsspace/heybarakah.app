{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env.local"],
  "tasks": {
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "outputs": [] },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": [
        "RESEND_API_KEY",
        "RESEND_AUDIENCE_ID",
        "RESEND_FROM",
        "RESEND_REPLY_TO",
        "POLAR_WEBHOOK_SECRET",
        "PUBLIC_CONVEX_URL"
      ]
    },
    "dev": { "cache": false, "persistent": true }
  }
}
